<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppColors.aberturaFundo: o topo do degrade da app bar no escuro. A
         splash do Android 12 e o primeiro quadro da abertura do Flutter
         usam esta mesma cor; e isso que faz as tres emendarem. -->
    <color name="fundo_abertura">#FF0A1726</color>
    <!-- AppColors.darkBg. Janela que fica **atras** do Flutter depois do
         primeiro quadro. Nao e a cor de abertura: se fosse, o azul
         reapareceria em transicoes e ao retomar o app. -->
    <color name="fundo_app">#FF03050A</color>
    <!-- Media das bordas de iconesoupm.png. E a cor de base do icone
         adaptativo, visivel so nas quinas de mascaras que passam do
         circulo inscrito. -->
    <color name="icone_borda">#FF144D65</color>
</resources>
